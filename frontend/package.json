{
  "name": "frontend",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "quality:structure": "node scripts/validate-frontend-structure.mjs",
    "lint": "npm run quality:structure && eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src --exclude '**/.claude/worktrees/**'",
    "quality:dead-code": "knip --include files,exports,types,dependencies,devDependencies,unlisted,binaries,unresolved,duplicates,cycles --treat-config-hints-as-errors --treat-tag-hints-as-errors"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@boundaries/eslint-plugin": "^7.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "knip": "^6.32.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
