# Copie para backend/.env e ajuste — .env nunca vai pro git.
NODE_ENV="development"
PORT="8080"
DATABASE_URL="postgresql://user:password@localhost:5432/application?schema=public"

# RabbitMQ is the approved EDA transport. Values belong to the environment.
RABBITMQ_URLS="amqp://localhost:5672"
RABBITMQ_VHOST="/application-local"
RABBITMQ_EXCHANGE="application.events"
RABBITMQ_PREFETCH="20"
RABBITMQ_TLS="false"
RABBITMQ_TOPOLOGY_MODE="assert"

# Transactional e-mail. Tests always use the in-memory provider. Local
# development stays in-memory unless this is explicitly set to "resend".
AUTH_EMAIL_PROVIDER="in-memory"
RESEND_API_KEY=""
RESEND_EMAILS_READ_API_KEY=""
EMAIL_FROM="Example App <no-reply@example.com>"
AUTH_EMAIL_DIAGNOSTICS_ENABLED="false"
AUTH_EMAIL_DIAGNOSTIC_SECRET=""
# Required verification challenge lifetime in milliseconds (10 minutes).
AUTH_EMAIL_VERIFICATION_TTL_MS="600000"
AUTH_FINGERPRINT_SECRET=""
AUTH_COOKIE_DOMAIN="localhost"
AUTH_REDIRECT_PATH="/"
AUTH_TERMS_VERSION="v1"

# Browser origins allowed to call the authentication API (CSRF allowlist).
# Keep the frontend on localhost:3000 and the backend on localhost:8080.
# This is a comma-separated list; it is not a list of e-mail-link hosts.
AUTH_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8080"

# One canonical origin used to build verification/magic-link URLs. Browser and
# e-mail links use the frontend on localhost:3000, whose /auth/* rewrite reaches
# the backend on localhost:8080. Do not put a comma-separated list here.
AUTH_PUBLIC_BASE_URL="http://localhost:3000"

# Google OIDC is disabled by default. When enabled in local development, the
# backend seals state, nonce, PKCE code_verifier, and the authorization URL in
# PostgreSQL with AES-256-GCM. Use a randomly generated secret of at least 32
# characters; never commit the value.
GOOGLE_OIDC_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_TRANSACTION_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8080/auth/google/callback"
GOOGLE_OIDC_ISSUER=""
GOOGLE_AUTHORIZATION_ENDPOINT=""
GOOGLE_TOKEN_ENDPOINT=""
GOOGLE_JWKS_URI=""
