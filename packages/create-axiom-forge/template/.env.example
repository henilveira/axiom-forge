# Copie este arquivo para backend/.env e ajuste os valores para o ambiente.
# O Frontend usa apenas frontend/.env.local; veja frontend/.env.example.

# Backend / Prisma
NODE_ENV=development                    # development, test ou production
COMPOSE_PROJECT_NAME=application        # namespace local do Docker Compose
PORT=8080                                # porta HTTP do NestJS
DATABASE_URL=postgresql://user:password@localhost:5432/application?schema=public  # conexão Prisma

# Backend / RabbitMQ
RABBITMQ_URLS=amqp://localhost:5672     # URLs AMQP; o vhost pode ser codificado na URL
RABBITMQ_VHOST=/application-local       # vhost esperado pelo compose local
RABBITMQ_EXCHANGE=application.events    # exchange de eventos
RABBITMQ_PREFETCH=20                    # limite de mensagens por consumidor
RABBITMQ_TLS=false                      # habilite quando o broker usar TLS
RABBITMQ_TOPOLOGY_MODE=assert           # modo seguro de declaração da topologia

# Backend / autenticação e sessão
AUTH_FINGERPRINT_SECRET=                # segredo aleatório com pelo menos 32 caracteres
AUTH_COOKIE_DOMAIN=localhost             # domínio do cookie; use domínio HTTPS em produção
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080  # allowlist CSRF/CORS
AUTH_PUBLIC_BASE_URL=http://localhost:3000  # origem pública dos links de e-mail
AUTH_REDIRECT_PATH=/                     # caminho interno após autenticação
AUTH_TERMS_VERSION=v1                    # versão dos termos aceita no cadastro
AUTH_EMAIL_VERIFICATION_TTL_MS=600000    # validade do desafio de e-mail em milissegundos
AUTH_EMAIL_PROVIDER=in-memory            # in-memory local/test ou resend em produção
AUTH_EMAIL_DIAGNOSTICS_ENABLED=false    # habilite apenas em desenvolvimento controlado
AUTH_EMAIL_DIAGNOSTIC_SECRET=           # segredo separado para diagnósticos de e-mail
EMAIL_FROM="Example App <no-reply@example.com>"  # remetente validado pelo provider
RESEND_API_KEY=                          # chave do Resend quando AUTH_EMAIL_PROVIDER=resend
RESEND_EMAILS_READ_API_KEY=              # opcional; leitura usada nos diagnósticos

# Backend / Google OIDC opcional
GOOGLE_OIDC_ENABLED=false                # false por padrão
GOOGLE_CLIENT_ID=                        # client ID OAuth/OIDC
GOOGLE_CLIENT_SECRET=                    # secret OAuth/OIDC
GOOGLE_OAUTH_TRANSACTION_SECRET=        # segredo aleatório com pelo menos 32 caracteres
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback  # callback registrado no Google
GOOGLE_OIDC_ISSUER=                      # opcional; default Google
GOOGLE_AUTHORIZATION_ENDPOINT=           # opcional; default Google
GOOGLE_TOKEN_ENDPOINT=                   # opcional; default Google
GOOGLE_JWKS_URI=                         # opcional; default Google

# Frontend / proxy server-only (copie para frontend/.env.local)
AUTH_BACKEND_URL=http://localhost:8080   # origem do Backend; nunca use NEXT_PUBLIC_
AUTH_PUBLIC_ORIGIN=http://localhost:3000 # origem pública do Frontend
